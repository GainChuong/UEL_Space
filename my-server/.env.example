# Copy this file to `.env` and adjust values as needed. Never commit the real `.env`.

PORT=3000
NODE_ENV=development

# MongoDB connection (docker compose provides this on 127.0.0.1:27017)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=uel_space

# Secret used to sign the session cookie. Use a long random value in real environments.
SESSION_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_STRING

# Allowed frontend origin for CORS (Angular dev server)
CLIENT_ORIGIN=http://localhost:4200

# Comma separated list of emails that become ADMIN on Google login
ADMIN_EMAILS=admin@uel.edu.vn,quantri@uel.edu.vn,system@uel.edu.vn

# Background jobs
ENABLE_JOBS=true
NO_SHOW_INTERVAL_MS=300000
OCCUPANCY_SNAPSHOT_INTERVAL_MS=900000
