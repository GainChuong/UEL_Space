@startuml
left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false

actor "Người dùng\n(Sinh viên / Giảng viên)" as User
actor "Quản lý Không gian\n(Space Manager)" as Manager
actor "Quản trị viên\n(System Admin)" as Admin

rectangle "Campus Space Management System" {
    
    package "Tra cứu & Đặt phòng" {
        usecase "Tra cứu lịch trống" as UC_Search
        usecase "Đặt phòng (Booking)" as UC_Book
        usecase "Quản lý đặt phòng cá nhân" as UC_ManageOwn
        usecase "Phê duyệt / Từ chối đặt phòng" as UC_Approve
    }
    
    package "Sử dụng & Giám sát (Occupancy)" {
        usecase "Check-in mã QR" as UC_CheckIn
        usecase "Check-out trả phòng" as UC_CheckOut
        usecase "Xem báo cáo thống kê sử dụng" as UC_ViewReports
    }

    package "Quản lý Sự cố (Incident)" {
        usecase "Báo cáo sự cố" as UC_ReportIncident
        usecase "Xử lý sự cố & Bảo trì" as UC_ResolveIncident
    }

    package "Quản trị Hệ thống (Admin)" {
        usecase "Quản lý Tổ chức (Tenant)" as UC_ManageOrg
        usecase "Quản lý Người dùng" as UC_ManageUsers
        usecase "Quản lý Danh mục Không gian" as UC_ManageSpaces
        usecase "Cấu hình Quy tắc (Business Rules)" as UC_ConfigRules
    }
}

' Người dùng relationships
User --> UC_Search
User --> UC_Book
User --> UC_ManageOwn
User --> UC_CheckIn
User --> UC_CheckOut
User --> UC_ReportIncident

' Space Manager relationships
Manager --> UC_Approve
Manager --> UC_ResolveIncident
Manager --> UC_ViewReports

' System Admin relationships
Admin --> UC_ManageOrg
Admin --> Admin : inherits? No.
Admin --> UC_ManageUsers
Admin --> UC_ManageSpaces
Admin --> UC_ConfigRules
Admin --> UC_ViewReports

' Manager also acts as a user (can book rooms, check-in)
Manager -|> User : "is a"

@enduml
