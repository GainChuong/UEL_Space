<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Incident">
    <bpmn:participant id="Participant_Incident" name="Incident Management System" processRef="Process_Incident" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_Incident" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Incident">
      <bpmn:lane id="Lane_Reporter" name="Reporter (User/Staff)">
        <bpmn:flowNodeRef>StartEvent_Incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitIncident</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_SaveIncident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LockSpace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnlockSpace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateResolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_IncidentClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Space Manager / Technician">
        <bpmn:flowNodeRef>Task_ReviewIncident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Severity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixSevere</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixMinor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkResolved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="StartEvent_Incident" name="Incident Detected">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_SubmitIncident" name="Submit Incident Report (F12)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SaveIncident" name="Save Incident (REPORTED)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_NotifyManager" name="Notify Manager">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ReviewIncident" name="Review Incident">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_Severity" name="Severity?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Severe</bpmn:outgoing>
      <bpmn:outgoing>Flow_Minor</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <!-- Severe branch -->
    <bpmn:task id="Task_LockSpace" name="Lock Space (MAINTENANCE)">
      <bpmn:incoming>Flow_Severe</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Severe" name="Severe" sourceRef="Gateway_Severity" targetRef="Task_LockSpace" />
    
    <bpmn:task id="Task_FixSevere" name="Fix Severe Issue">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_LockSpace" targetRef="Task_FixSevere" />
    
    <bpmn:task id="Task_UnlockSpace" name="Unlock Space (AVAILABLE)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_FixSevere" targetRef="Task_UnlockSpace" />
    
    <!-- Minor branch -->
    <bpmn:task id="Task_FixMinor" name="Fix Minor Issue">
      <bpmn:incoming>Flow_Minor</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Minor" name="Minor" sourceRef="Gateway_Severity" targetRef="Task_FixMinor" />
    
    <!-- Merge and Resolve -->
    <bpmn:exclusiveGateway id="Gateway_MergeFix">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_UnlockSpace" targetRef="Gateway_MergeFix" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_FixMinor" targetRef="Gateway_MergeFix" />
    
    <bpmn:task id="Task_MarkResolved" name="Mark as Resolved">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_MergeFix" targetRef="Task_MarkResolved" />
    
    <bpmn:task id="Task_UpdateResolved" name="Update Incident &amp; Notify User">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_MarkResolved" targetRef="Task_UpdateResolved" />
    
    <bpmn:endEvent id="EndEvent_IncidentClosed" name="Incident Closed">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_UpdateResolved" targetRef="EndEvent_IncidentClosed" />

    <!-- Sequence Flows (Initial path) -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Incident" targetRef="Task_SubmitIncident" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitIncident" targetRef="Task_SaveIncident" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SaveIncident" targetRef="Task_NotifyManager" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_NotifyManager" targetRef="Task_ReviewIncident" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReviewIncident" targetRef="Gateway_Severity" />
  </bpmn:process>
</bpmn:definitions>
