<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Booking">
    <bpmn:participant id="Participant_Booking" name="Space Management System" processRef="Process_BookingApproval" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_BookingApproval" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Booking">
      <bpmn:lane id="Lane_User" name="User (Student/Lecturer)">
        <bpmn:flowNodeRef>StartEvent_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ValidationError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ConflictError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>Task_ValidateData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetectConflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasConflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendQRCode</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Space Manager">
        <bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputReason</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveRequest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <bpmn:startEvent id="StartEvent_Booking" name="Start Booking">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_SubmitRequest" name="Create Booking Request">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ValidateData" name="Validate Data">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_IsValid" name="Valid?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:endEvent id="EndEvent_ValidationError" name="Validation Error">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_DetectConflicts" name="Detect Conflicts (F35)">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_HasConflict" name="Conflict?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_ConflictYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ConflictNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:endEvent id="EndEvent_ConflictError" name="Conflict Error">
      <bpmn:incoming>Flow_ConflictYes</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_SaveRequest" name="Save Request (PENDING)">
      <bpmn:incoming>Flow_ConflictNo</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_NotifyManager" name="Notify Manager">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ReviewRequest" name="Review Request">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_IsApproved" name="Approved?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:task id="Task_InputReason" name="Input Rejection Reason">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_UpdateRejected" name="Update Booking (REJECTED)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_NotifyRejection" name="Notify Rejection">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_Rejected" name="Booking Rejected">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_ApproveRequest" name="Approve Request">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_UpdateApproved" name="Update Booking &amp; Space Status">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_SendQRCode" name="Send QR Code">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:endEvent id="EndEvent_Approved" name="Booking Approved">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Booking" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_ValidateData" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ValidateData" targetRef="Gateway_IsValid" />
    <bpmn:sequenceFlow id="Flow_Invalid" name="No" sourceRef="Gateway_IsValid" targetRef="EndEvent_ValidationError" />
    <bpmn:sequenceFlow id="Flow_Valid" name="Yes" sourceRef="Gateway_IsValid" targetRef="Task_DetectConflicts" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_DetectConflicts" targetRef="Gateway_HasConflict" />
    <bpmn:sequenceFlow id="Flow_ConflictYes" name="Yes" sourceRef="Gateway_HasConflict" targetRef="EndEvent_ConflictError" />
    <bpmn:sequenceFlow id="Flow_ConflictNo" name="No" sourceRef="Gateway_HasConflict" targetRef="Task_SaveRequest" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SaveRequest" targetRef="Task_NotifyManager" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_NotifyManager" targetRef="Task_ReviewRequest" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ReviewRequest" targetRef="Gateway_IsApproved" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="No" sourceRef="Gateway_IsApproved" targetRef="Task_InputReason" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Yes" sourceRef="Gateway_IsApproved" targetRef="Task_ApproveRequest" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_InputReason" targetRef="Task_UpdateRejected" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_UpdateRejected" targetRef="Task_NotifyRejection" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyRejection" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ApproveRequest" targetRef="Task_UpdateApproved" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_UpdateApproved" targetRef="Task_SendQRCode" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SendQRCode" targetRef="EndEvent_Approved" />
  </bpmn:process>
</bpmn:definitions>
