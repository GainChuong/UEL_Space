<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Usage">
    <bpmn:participant id="Participant_Usage" name="Campus Usage System" processRef="Process_UsageSession" />
  </bpmn:collaboration>
  
  <bpmn:process id="Process_UsageSession" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Usage">
      <bpmn:lane id="Lane_User" name="User">
        <bpmn:flowNodeRef>StartEvent_CheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScanQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CheckInFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ManualCheckout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformCheckout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System / Cron Job">
        <bpmn:flowNodeRef>Task_ValidateCheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsValidCheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CronMonitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckAwayTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AwayTime</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendWarning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoCheckout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateReleaseCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CompleteSession</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EndSessionMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SessionEnded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Staff" name="Space Staff">
        <bpmn:flowNodeRef>Task_ResolveReleaseCase</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    
    <!-- Check-in Phase -->
    <bpmn:startEvent id="StartEvent_CheckIn" name="User arrives">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:task id="Task_ScanQR" name="Scan QR Code (F07)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ValidateCheckIn" name="Validate Booking &amp; Time">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_IsValidCheckIn" name="Valid?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_InvalidCI</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidCI</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:endEvent id="EndEvent_CheckInFailed" name="Check-in Failed">
      <bpmn:incoming>Flow_InvalidCI</bpmn:incoming>
    </bpmn:endEvent>
    
    <bpmn:task id="Task_StartSession" name="Start Usage Session &amp; Set OCCUPIED">
      <bpmn:incoming>Flow_ValidCI</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMonitor</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Monitoring Phase -->
    <bpmn:intermediateCatchEvent id="Event_CronMonitor" name="Timer (e.g. 5 mins)">
      <bpmn:incoming>Flow_ToMonitor</bpmn:incoming>
      <bpmn:incoming>Flow_LoopMonitor</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    
    <bpmn:task id="Task_CheckAwayTime" name="Check Away Time (F37)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_AwayTime" name="Away threshold?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Safe</bpmn:outgoing>
      <bpmn:outgoing>Flow_Warning</bpmn:outgoing>
      <bpmn:outgoing>Flow_AutoCO</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:sequenceFlow id="Flow_Safe" name="&lt; Warning limit" sourceRef="Gateway_AwayTime" targetRef="Event_CronMonitor" />
    
    <bpmn:task id="Task_SendWarning" name="Send Away Warning">
      <bpmn:incoming>Flow_Warning</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopMonitor</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Warning" name="&gt;= Warning limit" sourceRef="Gateway_AwayTime" targetRef="Task_SendWarning" />
    <bpmn:sequenceFlow id="Flow_LoopMonitor" sourceRef="Task_SendWarning" targetRef="Event_CronMonitor" />
    
    <bpmn:task id="Task_AutoCheckout" name="Auto Check-out (F38)">
      <bpmn:incoming>Flow_AutoCO</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_AutoCO" name="&gt;= Auto CO limit" sourceRef="Gateway_AwayTime" targetRef="Task_AutoCheckout" />
    
    <bpmn:task id="Task_CreateReleaseCase" name="Create Release Case (F39)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_ResolveReleaseCase" name="Resolve Release Case">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    
    <!-- Manual Checkout -->
    <bpmn:boundaryEvent id="Event_ManualCheckout" name="Manual Checkout" attachedToRef="Event_CronMonitor" cancelActivity="true">
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:boundaryEvent>
    
    <bpmn:task id="Task_PerformCheckout" name="Perform Check-out (F08)">
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:task id="Task_CompleteSession" name="Complete Session &amp; Set AVAILABLE">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:exclusiveGateway id="Gateway_EndSessionMerge">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    
    <bpmn:endEvent id="EndEvent_SessionEnded" name="Session Ended">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_CheckIn" targetRef="Task_ScanQR" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ScanQR" targetRef="Task_ValidateCheckIn" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ValidateCheckIn" targetRef="Gateway_IsValidCheckIn" />
    <bpmn:sequenceFlow id="Flow_InvalidCI" name="No" sourceRef="Gateway_IsValidCheckIn" targetRef="EndEvent_CheckInFailed" />
    <bpmn:sequenceFlow id="Flow_ValidCI" name="Yes" sourceRef="Gateway_IsValidCheckIn" targetRef="Task_StartSession" />
    <bpmn:sequenceFlow id="Flow_ToMonitor" sourceRef="Task_StartSession" targetRef="Event_CronMonitor" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Event_CronMonitor" targetRef="Task_CheckAwayTime" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CheckAwayTime" targetRef="Gateway_AwayTime" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_AutoCheckout" targetRef="Task_CreateReleaseCase" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CreateReleaseCase" targetRef="Task_ResolveReleaseCase" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ResolveReleaseCase" targetRef="Gateway_EndSessionMerge" />
    <bpmn:sequenceFlow id="Flow_Manual" sourceRef="Event_ManualCheckout" targetRef="Task_PerformCheckout" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_PerformCheckout" targetRef="Task_CompleteSession" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_CompleteSession" targetRef="Gateway_EndSessionMerge" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Gateway_EndSessionMerge" targetRef="EndEvent_SessionEnded" />
  </bpmn:process>
</bpmn:definitions>
