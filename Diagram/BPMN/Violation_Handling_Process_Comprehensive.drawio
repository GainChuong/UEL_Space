<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="violation_process" name="Violation Handling Process">
    <mxGraphModel dx="1434" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Pool -->
        <mxCell id="pool" value="Violation &amp; Appeal Handling Process" style="swimlane;childLayout=stackLayout;horizontal=0;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="1400" height="450" as="geometry" />
        </mxCell>
        
        <!-- Swimlanes -->
        <mxCell id="lane_sys" value="System (Rule Engine)" style="swimlane;horizontal=0;html=1;" vertex="1" parent="pool">
          <mxGeometry x="30" y="0" width="1370" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lane_user" value="User (Sinh viên/GV)" style="swimlane;horizontal=0;html=1;" vertex="1" parent="pool">
          <mxGeometry x="30" y="150" width="1370" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lane_mgr" value="Space Manager" style="swimlane;horizontal=0;html=1;" vertex="1" parent="pool">
          <mxGeometry x="30" y="300" width="1370" height="150" as="geometry" />
        </mxCell>

        <!-- Nodes System -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_sys">
          <mxGeometry x="50" y="55" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="task_detect" value="Phát hiện vắng mặt /&#xa;Trễ Check-in" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_sys">
          <mxGeometry x="150" y="45" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="task_cancel" value="Tự động hủy&#xa;Booking" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_sys">
          <mxGeometry x="320" y="45" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="task_record" value="Ghi nhận vi phạm &amp;&#xa;Cộng điểm phạt" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_sys">
          <mxGeometry x="490" y="45" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="gw_threshold" value="&gt; Mức cấm?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_sys">
          <mxGeometry x="660" y="35" width="80" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="task_warn" value="Gửi cảnh báo" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_sys">
          <mxGeometry x="830" y="90" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="task_ban" value="Tạm khóa tài khoản" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_sys">
          <mxGeometry x="830" y="10" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="task_unban" value="Mở khóa tài khoản" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_sys">
          <mxGeometry x="1170" y="10" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Nodes User -->
        <mxCell id="task_appeal" value="Gửi yêu cầu khiếu nại&#xa;(Appeal)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="830" y="45" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Nodes Manager -->
        <mxCell id="task_review" value="Xem xét khiếu nại" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_mgr">
          <mxGeometry x="830" y="45" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw_approve" value="Chấp nhận?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_mgr">
          <mxGeometry x="1000" y="35" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="task_reject" value="Từ chối khiếu nại" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_mgr">
          <mxGeometry x="1170" y="45" width="120" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="end_success" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=4;" vertex="1" parent="lane_mgr">
          <mxGeometry x="1340" y="55" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Edges System -->
        <mxCell id="e1" edge="1" parent="lane_sys" source="start" target="task_detect"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="lane_sys" source="task_detect" target="task_cancel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="lane_sys" source="task_cancel" target="task_record"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="lane_sys" source="task_record" target="gw_threshold"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        <mxCell id="e_t_yes" edge="1" parent="lane_sys" source="gw_threshold" target="task_ban"><mxGeometry relative="1" as="geometry" /><mxCell value="Vượt ngưỡng" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e_t_yes" /></mxCell>
        <mxCell id="e_t_no" edge="1" parent="lane_sys" source="gw_threshold" target="task_warn"><mxGeometry relative="1" as="geometry" /><mxCell value="Chưa vượt" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e_t_no" /></mxCell>
        
        <!-- Edges User Appeal -->
        <mxCell id="e5" edge="1" parent="pool" source="task_ban" target="task_appeal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="pool" source="task_appeal" target="task_review"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        <!-- Edges Manager Resolve -->
        <mxCell id="e7" edge="1" parent="lane_mgr" source="task_review" target="gw_approve"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        <mxCell id="e_a_no" edge="1" parent="lane_mgr" source="gw_approve" target="task_reject"><mxGeometry relative="1" as="geometry" /><mxCell value="Không" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e_a_no" /></mxCell>
        <mxCell id="e_a_yes" edge="1" parent="pool" source="gw_approve" target="task_unban"><mxGeometry relative="1" as="geometry" /><mxCell value="Đồng ý" style="edgeLabel;html=1;align=center;" vertex="1" connectable="0" parent="e_a_yes" /></mxCell>
        
        <!-- Edges End -->
        <mxCell id="e8" edge="1" parent="pool" source="task_reject" target="end_success"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" edge="1" parent="pool" source="task_unban" target="end_success"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
